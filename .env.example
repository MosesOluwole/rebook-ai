# Rebook AI local environment.
# Copy this file to .env (git-ignored):  cp .env.example .env
# Every variable is validated at boot by src/shared/config/env.ts; the app refuses to start otherwise.
# Placeholders only. Never put real credentials in this file.

# Runtime connection used by the app. rebook_authenticator is a login role with no table
# privileges; withTenant switches to rebook_app or rebook_worker inside every transaction.
# `pnpm db:roles` sets this password on the local role (see docs/setup.md).
APP_DATABASE_URL=postgresql://rebook_authenticator:rebook_local_dev@127.0.0.1:54322/postgres

# Owner connection (Supabase's postgres role). Used only by migrations, Drizzle Kit, `pnpm db:roles`
# and test fixtures. The app never reads it; leave it unset in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth of the local stack, used only by the server (the browser never talks to Supabase).
# Both values are printed by `pnpm db:status` (API_URL and PUBLISHABLE_KEY or ANON_KEY). The
# publishable/anon key is public by design; the admin key and JWT secret must never be configured.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public origin of the web app: the base of every link the app sends (invitations now, sign-in
# and booking links later) and of the same-origin check on form posts. Required; never derived
# from request headers. In development http://127.0.0.1 and http://[::1] on the same port are
# accepted as well. The client IP for rate limits is not configurable (ADR-004 §9).
APP_ORIGIN=http://localhost:3000
