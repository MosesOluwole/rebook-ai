{
  "name": "rebook-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Rebook AI: multi-tenant booking SaaS. Next.js modular monolith on Supabase Postgres.",
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=11.28.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:deps": "depcruise src tests scripts --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:deps && pnpm format:check && pnpm test",
    "db:start": "supabase start && pnpm db:roles",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset && pnpm db:roles",
    "db:migrate": "supabase migration up",
    "db:generate": "drizzle-kit generate",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:check-schema": "tsx scripts/check-schema.ts",
    "db:docs": "tsx scripts/generate-schema-doc.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
